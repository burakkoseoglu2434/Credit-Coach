# Credit Coach ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun

# SQLite DB yolu (ürün state)
DB_URL=sqlite:///./credit_coach_state.db

# Artifact çıktı kök dizini
ARTIFACT_DIR=./artifacts

# Log seviyesi: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# (İleride) PostgreSQL bağlantısı
# DB_URL=postgresql://user:password@localhost:5432/credit_coach
